meta {
  name: Dizi ekle
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/works
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "type": "SERIES",
    "title": "Breaking Bad",
    "year": 2008,
    "seasonCount": 5,
    "episodeCount": 62
  }
}

script:post-response {
  if (res.getStatus() < 400 && res.getBody() && res.getBody().id) {
    bru.setEnvVar("seriesId", res.getBody().id);
  }
}

docs {
  Korumali istek. Sezon/bolum sayilari ilerleme yuzdesini hesaplarken
  kullanilacagi icin diziye ozel alanlardir.
}
