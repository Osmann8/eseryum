meta {
  name: Film detayi
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/films/{{filmId}}
  body: none
  auth: none
}

docs {
  `filmId` ortam degiskeninden gelir; local ortamda varsayilani `1`.
  Olmayan bir id icin `404 KAYIT_BULUNAMADI` beklenir.

  Id'ler tur basina ayri tablodan geldigi icin `1` numarali film ile
  `1` numarali kitap farkli eserlerdir.
}
