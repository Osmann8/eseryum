# docker compose bu dizindeki .env dosyasini otomatik okur.
# Kopyala: cp .env.example .env  (Windows: copy .env.example .env)
# .env commit'lenmez; buradaki degerler sadece local icin ornektir.

POSTGRES_DB=eseryum
POSTGRES_USER=eseryum
POSTGRES_PASSWORD=eseryum
POSTGRES_PORT=5432

BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local

FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
